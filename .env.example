# Copy to .env.local for local development. Configure these on Vercel for deployment.
TYPESAFE_API_KEY=
JEV_GATEWAY_TOKEN=
NODEJS_HELPERS=0
JEV_DEFAULT_MODEL=jev-latest
JEV_UPSTREAM_TIMEOUT_MS=60000
JEV_MAX_CONCURRENCY=32
JEV_MAX_BODY_BYTES=1048576
# Set when verifying a deployment; omit a trailing /v1.
JEV_URL=http://127.0.0.1:3000
