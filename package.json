{
  "name": "jev-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "TypeSafe Jev API gateway for Vercel",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import=tsx server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "verify": "node --env-file-if-exists=.env.local scripts/verify.mjs",
    "start": "node --env-file-if-exists=.env.local dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
